{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": ".tsc-out/renderer",
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*.ts", "src/tools/*/renderer/**/*.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
