{
  "name": "etoolbox-daisy",
  "productName": "EToolbox Daisy",
  "version": "0.1.1",
  "description": "Desktop application pairing a private AEM browser with agentic frameworks.",
  "private": true,
  "main": "out/main/index.js",
  "author": "EToolbox Daisy",
  "license": "MIT",
  "updates": {
    "urls": [
      "https://github.com/exadel-inc/etoolbox-daisy/tree/master/update",
      "https://github.com/smiakchilo/etoolbox-daisy/tree/master/update"
    ]
  },
  "scripts": {
    "postinstall": "npm run addons:install",
    "addons:install": "node scripts/addons-install.mjs",
    "addons:build": "node scripts/build-addons.mjs",
    "addons:zip": "node scripts/build-addons.mjs --zip",
    "dev": "npm run icons && npm run addons:build && npm run build:webview-preload && electron-vite dev",
    "build": "npm run icons && npm run addons:build && electron-vite build && npm run build:webview-preload",
    "build:webview-preload": "electron-vite build --config electron.vite.webview-preload.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:mac": "npm run build && electron-builder --mac",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.13",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@openrouter/agent": "0.11.0",
    "@openrouter/sdk": "0.13.67",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "marked": "18.0.13",
    "quickjs-emscripten-core": "0.32.0",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@github/copilot": "1.0.83",
    "@playwright/test": "1.63.0",
    "@spectrum-web-components/action-button": "1.12.2",
    "@spectrum-web-components/action-menu": "1.12.2",
    "@spectrum-web-components/alert-banner": "1.12.2",
    "@spectrum-web-components/button": "1.12.2",
    "@spectrum-web-components/checkbox": "1.12.2",
    "@spectrum-web-components/contextual-help": "1.12.2",
    "@spectrum-web-components/field-label": "1.12.2",
    "@spectrum-web-components/icons-ui": "1.12.2",
    "@spectrum-web-components/icons-workflow": "1.12.2",
    "@spectrum-web-components/menu": "1.12.2",
    "@spectrum-web-components/overlay": "1.12.2",
    "@spectrum-web-components/picker": "1.12.2",
    "@spectrum-web-components/picker-button": "1.12.2",
    "@spectrum-web-components/popover": "1.12.2",
    "@spectrum-web-components/progress-circle": "1.12.2",
    "@spectrum-web-components/radio": "1.12.2",
    "@spectrum-web-components/split-view": "1.12.2",
    "@spectrum-web-components/status-light": "1.12.2",
    "@spectrum-web-components/table": "1.12.2",
    "@spectrum-web-components/tabs": "1.12.2",
    "@spectrum-web-components/textfield": "1.12.2",
    "@spectrum-web-components/theme": "1.12.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "png2icons": "2.0.1",
    "prettier": "3.9.6",
    "selfsigned": "5.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5"
  }
}
